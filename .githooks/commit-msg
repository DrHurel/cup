#!/bin/sh
# Refuse un commit sans référence de ticket (tools/flow/ticket_check.py, flow.toml [tickets]).
# Branché par `just hooks` (git config core.hooksPath .githooks).
PY=$(command -v python3 || command -v python)
exec "$PY" "$(git rev-parse --show-toplevel)/tools/flow/ticket_check.py" message "$1"
