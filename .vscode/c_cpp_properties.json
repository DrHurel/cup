{
    "configurations": [
        {
            "name": "cup-cpp (gcc-15, C++23 named modules)",
            // compile_commands.json is the authority: cup's CMake sets
            // CMAKE_EXPORT_COMPILE_COMMANDS, so every translation unit is described
            // with the exact flags it is built with. Configure once
            // (`cmake -G Ninja -B build/Debug -DCMAKE_BUILD_TYPE=Debug`, or
            // CMake Tools) and IntelliSense follows the build.
            "compileCommands": "${workspaceFolder}/build/Debug/compile_commands.json",
            // Fallback for files the database does not cover yet — a .cppm that has
            // not been added to a target, and the embedded-template header generated
            // by cmake/EmbedTemplates.cmake.
            "includePath": [
                "${workspaceFolder}/src/**",
                "${workspaceFolder}/build/Debug/generated/**"
            ],
            "defines": [],
            // GCC 15 is the project's floor (raised from GCC 14 in Phase 4 — see
            // docs/migration-cpp23.md); g++-13, noble's own default, cannot build
            // named modules at all.
            "compilerPath": "/usr/bin/g++-15",
            "compilerArgs": [
                "-std=c++23"
            ],
            "cStandard": "c23",
            "cppStandard": "c++23",
            "intelliSenseMode": "linux-gcc-x64"
        }
    ],
    "version": 4
}
